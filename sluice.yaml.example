# sluice configuration example. Copy to sluice.local.yaml (git-ignored) and point
# SLUICE_CONFIG at it. Every key is optional; unset keys fall back to code
# defaults. Secrets (API keys, private hostnames) come from the environment or a
# git-ignored local overlay, never this file.

# Ingestion (sub-app #1): per-source enable/disable + tuning, target locations,
# and per-source search overrides. Each source ships with ONE neutral example
# search; set `searches` to run your own. Entries are [label, url, {params}?] -
# the optional params tag the resulting leads (e.g. {job_type: perm}). This is
# where your personal search list lives, so keep this file out of any public repo.
# (Geography moved: the root `locations` key was read by nothing and is retired -- setting
# it now raises. Declare where you will work under `triage.target_locations` below.)

# Days since a lead was last seen in a scrape before `sluice leads expire` proposes
# dismissing it, and before `cv run` and `apply prep` refuse to spend on it. 0 = OFF,
# which is the shipped default. Commented out rather than set, for the same reason as
# `locations` above: this file is COPIED, and an active value would hand every copier a
# judgement about what counts as stale that they never made. Staleness is only ever a
# cheap proxy -- whether the role is still open can only be answered on the employer's
# own site, so this does not replace checking before you apply.
# lead_ttl_days: 90   # <- uncomment and set YOUR OWN

# How the lead store FILES your notes on disk (#1). "" (the shipped default) is flat: every note
# in one directory, exactly as before this existed. "active_archive" splits them into Active/ and
# Archive/ -- Archive holds dismissed leads and every finished application (rejected, accepted,
# withdrawn) -- and NOTHING moves on its own: `sluice leads reconcile` reports the drift, and only
# `--apply` files anything. The scan is recursive either way, so subfolders you make yourself are
# read as leads and are never relocated. Commented out rather than set, for the same reason as
# `lead_ttl_days` above: this file is COPIED, and an active value would hand every copier a filing
# decision they never made.
# lead_layout: active_archive   # <- uncomment to opt in

# ── adapter seams ────────────────────────────────────────────────────────────
# Which implementation fills each seam. Selection is by NAME; an unknown name raises at
# construction and lists the valid ones rather than falling through to a default.
# (`sluice/stores/`, `sluice/fetchers/`, `sluice/renderers/` -- a new plugin registers
# itself there and becomes selectable here, with no change to core.)
store: vault        # the lead/experience store
fetcher: camofox    # the browser the ingest sources drive
# Where the STORE keeps your baseline CV, relative to the store root. Lives here rather
# than under `cv:` because only the store can honour it.
baseline_rel: My CV/CV.md

# Where your vault lives. Unset, sluice uses ./vault (relative to wherever you run it),
# and $VAULT_DIR still wins over this key. The vault is the one path sluice does NOT
# relocate to a per-system directory -- it is your Obsidian directory, not sluice's
# state -- so this key exists mainly so the answer survives a new shell.
# vault_dir:          # <- uncomment and set YOUR OWN
#
# Where the dossier cache lives. ONE key for both triage and cv, which share the cache;
# splitting them makes cv re-fetch every job ad. Unset, it resolves per-system, under
# $XDG_CACHE_HOME (or ~/.cache) -- $DOSSIER_DIR still wins over this key. Everything
# under it is re-fetchable, so losing it costs a refetch, not data. A leading `~` in a
# value you set here (or in the variable) is expanded -- as it is for every key that
# resolves per-system, which is this one, the two `track` paths and `triage.audit_jsonl`.
# The cv/apply working directories below do NOT expand one: they name a folder in the
# directory you are standing in, so write those out in full.
# dossier_dir:        # <- uncomment and set YOUR OWN

# Hosts the dossier fetcher may reach even though they are not globally routable.
# The fetcher follows lead urls scraped off job boards, so by default it refuses
# non-http(s) schemes and any address that is not globally routable (loopback,
# private, link-local, cloud-metadata, ...). Empty grants no exceptions; it does
# NOT block public urls, which are admitted by the address rule rather than by
# this list. Set it only if you deliberately run a board on your own network.
# Entries are a hostname (exact, no subdomains) or a CIDR / bare IP. Prefer a CIDR
# where you can name one: a hostname grant covers EVERY address that name resolves
# to (today, and at each future fetch), which is strictly wider than the addresses
# a network grant admits -- a CIDR bounds the exception to specific addresses no
# matter what any name later resolves to.
# dossier_allow_hosts:
#   - jobs.invalid
#   - 10.0.0.0/8

# Coarse ingest title filter, applied before dedup and long before any LLM call.
# Personal, so empty by default (an unconfigured gate passes everything through).
# Configure it to make ingest cheap. Placeholders below are generated nonsense.
relevance_keep: ['horticultural consultant']   # keep only titles containing one of these
relevance_drop: ['sport and exercise psychologist']   # ...then drop any containing one of these

# Words that decorate a location without locating it (a work-mode, a board's furniture),
# subtracted before #5 decides whether two same-title postings are the same job. Empty by
# default -> nothing subtracted. Uncomment to, e.g., merge a "Remote" and a city listing.
# location_noise_words:
#   - remote

# Tokens stripped from a job TITLE before `sluice leads dedupe` decides two roles are the
# same posting. Empty by default (strictest: only near-identical titles cluster). Add board
# decorations you observe. Generic examples only — never your real filter list.
# dedupe_title_noise_words:
#   - remote
#   - hybrid
#   - contract
# sources:
#   workinstartups: { enabled: false }
#   linkedin:
#     searches:
#       - ["Example role, city", "https://www.linkedin.com/jobs/search/?keywords=software%20developer&location=London", {job_type: perm}]
#       - ["Example role, remote", "https://www.linkedin.com/jobs/search/?keywords=software%20developer&location=Remote", {job_type: perm}]
#   reed:
#     searches:
#       - ["Example contract role", "https://www.reed.co.uk/jobs/contract-software-developer-jobs-in-london?sortby=datecreated"]

# Triage (sub-app #2): role/geo/pay rules + judge routing. Lists shown here
# override the code defaults wholesale when set.
triage:
  batch_size: 5
  ttl_days: 7
  # Where the rejected-leads audit log is written. Unset, it resolves per-system under
  # $XDG_STATE_HOME (or ~/.local/state); $TRIAGE_AUDIT still wins over this key. This key
  # was declared but read by nothing before #80 -- setting it did nothing, silently.
  # A leading `~` is expanded, in the key and in the variable alike.
  # audit_jsonl:        # <- uncomment and set YOUR OWN
  contract_floor_gbp_day: 450     # illustrative; set your own (0 = no floor)
  perm_floor_gbp: 90000          # illustrative; set your own (0 = no floor)
  primary_backend: claude-max
  fallback_backend: deepseek
  # Model ids are BARE, not provider/model: the value is sent verbatim as the API's
  # `model` field (the provider is already chosen by the *_backend keys above), so
  # an "anthropic/" or "deepseek/" prefix here would 400.
  claude_max_model: claude-sonnet-4-5    # the primary_backend's model
  cheap_model: deepseek-v4-flash         # the fallback_backend's model
                                         # (deepseek-chat is retired 2026-07-24)
  # Which roles you want, and which disqualify a role, is PERSONAL. Nothing ships in
  # code: declare yours here. The values below are randomly generated placeholders,
  # deliberately nonsense, so nobody inherits somebody else's taste. Leave both empty
  # and the title gate abstains: every lead reaches the LLM judge.
  # Where you are willing to work. Empty = no geographic gate at all, which is the shipped
  # default. Commented rather than set, for the same reason as `lead_ttl_days` above: this
  # file is COPIED, and an active value would hand every copier a judgement about geography
  # they never made.
  # target_locations: [Antarctica]   # <- uncomment and set YOUR OWN
  # Locations that disqualify a lead outright. Same shape, same reasoning.
  # reject_locations: [Antarctica]   # <- uncomment and set YOUR OWN
  accept_titles: ['horticultural consultant', 'geoscientist']   # <- replace with the roles YOU want
  reject_titles: ['sport and exercise psychologist', 'broadcast engineer']   # <- replace with your disqualifiers
  route_borderline: false
  # reject_companies: [example-co]
  # claude_max_host: <your-claude-host>    # empty runs claude_max_path locally
  # claude_max_path: claude

# CV tailoring (sub-app #3): entirely personal, so every field below is empty
# or a neutral placeholder by default.
# cv:
#   # Which renderer fills the seam.
#   #   template - fills a Jinja2 template with the parsed CV, via WeasyPrint. This is the
#   #              default, and it works out of the box: leave `template` below blank and
#   #              it renders the PACKAGED layout; point it at your own .html.j2 file to
#   #              use yours instead. sluice supplies the content (the fabrication-gated
#   #              CvDocument), never the layout -- shipping a CV design would be the same
#   #              mistake as shipping an opinion about which jobs are good. Needs
#   #              `pip install 'sluice[render]'`; WeasyPrint's system libraries (cairo,
#   #              pango, gdk-pixbuf) are NOT a Python dependency and cannot be made one --
#   #              see README's Rendering prerequisites, including a macOS loader-path
#   #              gotcha that is easy to hit even with the libraries installed.
#   #   script   - the full-control escape hatch: shells out to an external render script
#   #              you supply at render_script. No script ships in the repo, so this fails
#   #              at construction (not after the CV is composed) until you point it at
#   #              your own.
#   #   `weasyprint` (the old bundled renderer, a fixed <pre> dump with no template) is
#   #   RETIRED: selecting it now raises, naming `template` as the replacement.
#   renderer: template
#   # Blank (the default) uses the packaged layout. Point this at your own .html.j2 file
#   # to use yours instead -- docs/cv-template-example.html.j2 is a worked example of the
#   # CvDocument contract a template renders against (document.name, .contact, .profile,
#   # .work[].company/.dates/.location/.title/.bullets, .certificates, .education).
#   template: <path-to-your-template.html.j2>
#   render_script: ./scripts/cv_render_v2.py
#   # An `unsupported` audit claim (anywhere in the CV, not just the profile) WITHHOLDS the
#   # send-ready pointer until you `sluice cv signoff` the lead, rather than auto-serving.
#   # Ships on (a safety valve, not a preference); set false to restore auto-serve.
#   require_signoff: true
#   # Required before composing works (#99): a CV composed while this is still the
#   # shipped placeholder "Your Name" is refused before any spend, because this value
#   # becomes the PDF's <h1> -- a composer complying with the prompt exactly as
#   # configured would otherwise headline the document with the literal placeholder,
#   # a wrong artefact no format guard can distinguish from a genuine name.
#   name: <your full name>
#   contact: |
#     Phone number: +1 555 0100
#     Email address: you@example.com
#     Web: https://www.linkedin.com/in/you/
#   employers: [Employer A, Employer B]   # empty skips the per-employer gate
#   fabrication_decoys: [Some Other Company]
#   served_prefix: CV
#   compose_host: <your-claude-host>       # empty runs compose_claude_path locally
#   compose_claude_path: claude
#   compose_timeout: 300                   # seconds PER INVOCATION PER LEG. The engine
#                                          # composes up to twice and then audits (three
#                                          # invocations), and under the default `auto`
#                                          # role each one may try the primary AND then
#                                          # the fallback -- so a lead's worst case is
#                                          # SIX times this. Applies to both legs.
#                                          # Raise it if compositions degrade to the
#                                          # fallback mid-run (logged at WARNING). Must be
#                                          # a positive integer -- there is no "off", and
#                                          # `yes` is refused rather than read as 1 second.

# Apply (sub-app #4): stage the rendered CV + a prep packet for a shortlisted
# lead. served_prefix must stay in sync with cv.served_prefix above (both
# default to "CV"); only one adapter selector value works for each of
# backend/store/renderer/fetch today, see docs/ARCHITECTURE.md.
# apply:
#   served_prefix: CV  # must match cv.served_prefix

# Track (sub-app #5): reconciles Gmail/Calendar signals against shortlisted and
# applied leads (scheduling, offers, rejections, and application receipts).
track:
  # track's own dedup database, and the Google OAuth token. NEITHER has an environment
  # override, so these config keys are the only way to move them. Unset, both resolve
  # per-system under $XDG_STATE_HOME (or ~/.local/state). seen_db is the one that costs
  # most when it is wrong: the last-run watermark and the dead-letter store of
  # un-acted-on proposals are both derived from it, so a stray value silently hides the
  # whole backlog. sluice refuses to start rather than run against a relocated one.
  # A leading `~` is expanded; these two keys are the likeliest place to write one,
  # since neither has an environment variable to set instead.
  # seen_db:            # <- uncomment and set YOUR OWN
  # token_path:         # <- uncomment and set YOUR OWN (written 0600)
  # Minimum confidence (0..1) for the LLM's "this is an application receipt"
  # classification to AUTO-advance a shortlist lead to `applied` on a domain-PROOF
  # match. Proof also requires that the delivering server AUTHENTICATED the sender
  # domain (a DKIM/DMARC/SPF pass aligned with it) -- a From header is free text
  # anyone can forge, and a wrong `applied` silently suppresses a real application.
  # A corroborated (ATS-relay + company-in-body), unauthenticated or ambiguous match
  # always proposes for `sluice track confirm`, regardless of this value.
  auto_apply_min: 0.75
  # ats_relay_domains and job_board_domains together list the hosts SHARED BY MANY
  # EMPLOYERS: ATS relays, and the job boards sluice scrapes. Both are SAFETY
  # DENYLISTS, not preference gates. A receipt sent from one of these hosts is never
  # treated as domain-PROOF of a specific company (the host serves many), only as
  # corroboration when the company is also named in the body -- and a lead whose own
  # `url` is such a host can never be proof-matched either, since a board-sourced
  # lead's url identifies the BOARD, not the employer. Both defaults are non-empty by
  # design; emptying one makes the proof tier MORE permissive, not less.
  #
  # Anything you set here is MERGED OVER the shipped defaults, never replacing them:
  # add your own in-house ATS or board and the shipped entries all survive. (The
  # corollary is that a shipped entry cannot be removed from config -- deliberate for
  # a safety denylist. You can relabel one by reusing its key.) A value that is not
  # a mapping of host -> label is an ERROR, not a silent replacement: sluice refuses
  # to start rather than run with an emptied safety list.
  # ats_relay_domains:
  #   ats.example.invalid: in-house
  # job_board_domains:
  #   board.example.invalid: example-board
